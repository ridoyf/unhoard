<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="unhoard.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Ridoy Farhad\Unhoard">
    </Installer>
    <PackageInformation
        PackageName="Unhoard"
        PackageDisplayName="Unhoard"
        PublisherName="CN=Ridoy Farhad"
        PublisherDisplayName="Ridoy Farhad"
        Version="0.1.0.0"
        PackageDescription="Understand and reclaim disk space">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ridoyf.unhoard"
                Description="Understand and reclaim disk space"
                DisplayName="Unhoard"
                ExecutableName="unhoard.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Unhoard</DisplayName>
            <PublisherDisplayName>Ridoy Farhad</PublisherDisplayName>
            <Description>Understand and reclaim disk space</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="unhoard.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
